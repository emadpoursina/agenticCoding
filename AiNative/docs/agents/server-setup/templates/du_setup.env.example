# ==============================================================================
# du_setup.env.example — project-agnostic Ubuntu VPS baseline
# ==============================================================================
# Copy to the host and restrict permissions:
#
#   scp templates/du_setup.env.example <admin>@<host>:/tmp/du_setup.env
#   ssh -t <admin>@<host> 'sudo install -m 600 /tmp/du_setup.env /root/du_setup.env && rm /tmp/du_setup.env'
#
# Then follow the fast path in ../SKILL.md. Review every value before running.
# Never commit a filled copy: it contains a public key and may contain tokens.
# ==============================================================================

# --- Required admin user and SSH key ---
DU_USERNAME="deploy"
DU_SSH_PUBLIC_KEY="PASTE_YOUR_SSH_PUBLIC_KEY_HERE"
DU_USE_EXISTING_USER="true"

# --- System identity and SSH port ---
# Empty hostname keeps the provider-assigned short hostname.
DU_HOSTNAME=""
DU_PRETTY_HOSTNAME=""
# Keep 22 by default. A port change needs provider firewall + ssh.socket work.
DU_SSH_PORT="22"
DU_TIMEZONE="Etc/UTC"

# --- Sudo and password policy ---
DU_USER_PASSWORD=""
DU_GENERATE_RANDOM_PASSWORD="true"
DU_PASSWORDLESS_SUDO="false"
DU_INSTALL_CUSTOM_BASHRC="false"

# --- Firewall (UFW) ---
# Keep both false for an SSH-only host. Open only when the host is web-facing.
DU_ALLOW_HTTP="false"
DU_ALLOW_HTTPS="false"
DU_ALLOW_TAILSCALE_UDP="false"
DU_CUSTOM_UFW_PORTS=""

# --- Intrusion prevention ---
# fail2ban is the default. Use "crowdsec" only for a declared public web host.
DU_IDS="fail2ban"
DU_FAIL2BAN_WHITELIST_CURRENT_IP="true"
# Add admin IPs and VPN CIDRs, e.g. "203.0.113.10 100.64.0.0/10".
DU_FAIL2BAN_IGNORE_IPS=""
DU_FAIL2BAN_UFW_PROBES="false"

DU_CROWDSEC_COLLECTIONS=""
DU_CROWDSEC_ENROLL_KEY=""

# --- Patching and system hardening ---
DU_ENABLE_AUTO_UPDATES="true"
DU_ENABLE_SECURE_DNS="false"
DU_ENABLE_KERNEL_HARDENING="true"

# --- Docker and container firewall (project layer) ---
DU_INSTALL_DOCKER="false"
# Set true only when Docker is present and published ports must not bypass UFW.
DU_DOCKER_UFW_HARDEN="false"
DU_INSTALL_DTOP="false"

# --- Mesh VPN (optional) ---
# Options: none | tailscale | netbird | both
DU_VPN="none"
DU_TAILSCALE_AUTH_KEY=""
DU_TAILSCALE_LOGIN_SERVER=""
DU_TAILSCALE_FLAGS=""
DU_NETBIRD_SETUP_KEY=""
DU_NETBIRD_MANAGEMENT_URL=""

# --- Swap and auditing ---
# Set true only when RAM is under 2 GB and no swap exists.
DU_CONFIGURE_SWAP="false"
DU_SWAP_SIZE="2G"
DU_SWAPPINESS="10"
DU_VFS_CACHE_PRESSURE="50"

DU_RUN_SECURITY_AUDIT="true"
# Debian-only; leave false on Ubuntu.
DU_RUN_DEBSECAN="false"

# Never reboot unattended. Schedule it with the operator.
DU_AUTO_REBOOT="false"
