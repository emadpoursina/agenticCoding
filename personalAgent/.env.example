# Copy to .env and fill in. Never commit .env.

# Host paths — used only by Docker Compose. Application code must read
# container paths (/ainative, /workspaces, /opt/data).
AINATIVE_PATH=/Users/emad/Projects/playground/agenticCoding/AiNative
WORKSPACE_ROOT=/Users/emad/Projects/playground/agenticCoding/personalAgent/workspaces
HERMES_HOME=/Users/emad/.hermes/personal-agent

# Host user that owns HERMES_HOME so container-created files stay writable.
HERMES_UID=501
HERMES_GID=20

# Optional OpenAI-compatible provider (9router, OpenRouter, etc.).
# Leave unset to use whatever model is configured inside Hermes
# (HERMES_HOME/config.yaml). Never commit keys.
# OPENAI_BASE_URL=http://host.docker.internal:20128/v1
# OPENAI_API_KEY=

# Hermes web UI (chat + config). Open http://localhost:9119 after compose up.
# Sign-in uses the username/password below (not your model API key).
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me-local

# SSH agent socket forwarded into hermes-personal-agent (never copy private keys).
# Docker Desktop (Mac/Windows) uses /run/host-services/ssh-auth.sock by default.
# Linux: set DOCKER_SSH_AUTH_SOCK to the host path from `echo $SSH_AUTH_SOCK`
# (often /run/user/UID/keyring/ssh
# or /tmp/ssh-XXXX/agent.NNN). Compose mounts it at /run/host-services/ssh-auth.sock
# inside the container.
SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock

# Optional GitHub CLI token for pull-request commands (gh). Leave unset if unused.
# Prefer exporting GH_TOKEN in the host shell before `docker compose up`, or set it
# only in this local .env (gitignored). Never commit a real token.
# The boot script runs `gh auth login --with-token` when this value is non-empty
# and stores CLI config under /opt/data/.config/gh (the persisted Hermes home).
# GH_TOKEN=
